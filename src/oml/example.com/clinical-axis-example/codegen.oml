@dc:title "Imaging Triage Codegen Configs"
@dc:description "Consumer Config that runs the packaged Clinical AXIS gate-readiness Spec."
description <https://example.com/clinical-axis-example/codegen#> as configs {
    uses <http://purl.org/dc/elements/1.1/> as dc
    uses <http://opencaesar.io/codegen#> as codegen
    extends <http://clinical-axis.org/method/codegen/gate-readiness#> as gate_readiness

    instance gate : codegen:Config [
        codegen:spec gate_readiness:GateReadinessSpec
        codegen:context "https://example.com/clinical-axis-example/bundle"
        codegen:binding [ codegen:key "path" codegen:value "build/docs" ]
    ]
}
